---
// BaseLayout.astro — Default layout for all pages
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DisclaimerBanner from '../components/DisclaimerBanner.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
}

const { title, description, ogImage, canonicalURL } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead {title} {description} {ogImage} {canonicalURL} />
  <!-- UX-FIX-WAVE1 tap-target + responsive -->
  <style>
    a, button, input, select, textarea, summary, [role="button"] { min-height: 44px; box-sizing: border-box; }
    button, input, select, textarea, .btn, a.btn, [role="button"] { min-width: 44px; }
    a { display: inline-flex; align-items: center; }
    img, video, table, pre, iframe, svg { max-width: 100%; height: auto; }
    html, body { overflow-wrap: break-word; word-wrap: break-word; }
  </style>
</head>
  <body class="bg-paper-50 text-ink-900 font-sans min-h-screen flex flex-col">
    <Header />
    <DisclaimerBanner />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
      <!-- R195：简中页咨询入口只走本站企业微信客服；lead.js 简中分支渲染「微信咨询」按钮。
         data-color / data-accent 必须带 —— lead.js 要把它们转发给运行时面板，缺了会静默丢主题。 -->
    <script
      src="https://chat.accreditation.cn/lead.js"
      data-site="accreditation-cn"
      data-lang="zh-CN"
      data-color="#1a365d"
      data-accent="#991b1b"
      async></script>
  </body>
</html>
