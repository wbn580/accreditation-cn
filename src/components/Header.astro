---
// Header.astro — Dual-name official-style header
---
<header class="border-b border-divider bg-white">
  <div class="max-w-6xl mx-auto px-5 py-4">
    <div class="flex items-baseline gap-5 flex-wrap">
      <a href="/" class="no-underline hover:opacity-85 transition-opacity">
        <span class="font-serif text-2xl font-bold text-primary-700 tracking-tight">
          全球认证信息汇编
        </span>
      </a>
      <span class="text-ink-400 text-sm font-sans tracking-wider uppercase hidden sm:inline">
        Global Accreditation Registry
      </span>
    </div>
    <nav class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm font-medium text-ink-600" aria-label="主导航">
      <a href="/university/" class="hover:text-primary-600 transition-colors">高等院校认证</a>
      <a href="/agent/" class="hover:text-primary-600 transition-colors">留学中介认证</a>
      <a href="/migration/" class="hover:text-primary-600 transition-colors">移民顾问认证</a>
      <a href="/broker/" class="hover:text-primary-600 transition-colors">金融顾问认证</a>
      <a href="/legal/" class="hover:text-primary-600 transition-colors">律师律所认证</a>
      <a href="/medical/" class="hover:text-primary-600 transition-colors">医师机构认证</a>
      <a href="/insights/" class="hover:text-primary-600 transition-colors">深度分析</a>
      <a href="/glossary/" class="hover:text-primary-600 transition-colors">术语词汇表</a>
      <a href="/faq/" class="hover:text-primary-600 transition-colors">常见问题</a>
    </nav>
  </div>
</header>
