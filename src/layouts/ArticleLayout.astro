---
// ArticleLayout.astro — Layout for individual articles
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DisclaimerBanner from '../components/DisclaimerBanner.astro';
import ArticleDisclaimer from '../components/ArticleDisclaimer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  publishDate?: string;
  category?: string;
  categoryLabel?: string;
  readingTime?: number;
  tags?: string[];
  dataSources?: { name: string; url?: string }[];
  schema?: string;
}

const {
  title, description, ogImage, canonicalURL,
  publishDate, category, categoryLabel, readingTime,
  tags = [], dataSources = [], article
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    {/* geo-seo-v2.1: 文章页 Article JSON-LD */}
    {article && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Article',
      headline: title, description: description,
      datePublished: article.datePublished, dateModified: article.dateModified,
      author: { '@type': 'Organization', name: "全球认证信息汇编" },
      publisher: { '@type': 'Organization', name: "全球认证信息汇编", url: "https://accreditation.cn/" },
      mainEntityOfPage: "https://accreditation.cn/",
    })} />}
    <BaseHead {title} {description} {ogImage} {canonicalURL} />
    {Astro.props.schema && <script type="application/ld+json" set:html={Astro.props.schema}></script>}
  </head>
  <body class="bg-paper-50 text-ink-900 font-sans min-h-screen flex flex-col">
    <Header />
    <DisclaimerBanner />
    <main class="flex-1">
      <article class="prose prose--wide py-12">
        <!-- Breadcrumb -->
        <nav class="text-sm text-ink-400 mb-6" aria-label="面包屑导航">
          <a href="/" class="hover:text-primary-600">首页</a>
          {category && (
            <>
              <span class="mx-2">/</span>
              <a href={`/${category}/`} class="hover:text-primary-600">{categoryLabel || category}</a>
            </>
          )}
          <span class="mx-2">/</span>
          <span class="text-ink-600">{title}</span>
        </nav>

        <!-- Article Header -->
        <header class="mb-8">
          <h1 class="text-3xl font-serif font-bold text-ink-900 leading-tight mb-4">{title}</h1>
          <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-500">
            {publishDate && <time datetime={publishDate}>整理日期：{publishDate}</time>}
            {readingTime != null && <span>阅读约 {readingTime} 分钟</span>}
          </div>
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-3">
              {tags.map((tag) => (
                <span class="px-2 py-0.5 bg-primary-50 text-primary-700 text-xs rounded">{tag}</span>
              ))}
            </div>
          )}
        </header>

        <!-- Article Body -->
        <slot />

        <!-- Article Disclaimer -->
        <ArticleDisclaimer {dataSources} {publishDate} />
      </article>
    </main>
    <Footer />
      <!-- R195：简中页咨询入口只走本站企业微信客服；lead.js 简中分支渲染「微信咨询」按钮。
         data-color / data-accent 必须带 —— lead.js 要把它们转发给运行时面板，缺了会静默丢主题。 -->
    <!-- R105：本站是内容型非业务站（没有报价/比价/计算器页，也没在 ai-widget site-bots 登记 per-site bot），主按钮显式取消，只留企业微信咨询按钮（R103）。不写 = 吃 ai-widget 默认的留学申请评估表单。 -->
    <script
      src="https://chat.accreditation.cn/lead.js"
      data-site="accreditation-cn"
      data-main-action="none"
      data-lang="zh-CN"
      data-color="#1a365d"
      data-accent="#991b1b"
      async></script>
  </body>
</html>
