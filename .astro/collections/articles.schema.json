{
  "$ref": "#/definitions/articles",
  "definitions": {
    "articles": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "university",
            "agent",
            "migration",
            "broker",
            "legal",
            "medical",
            "insights",
            "glossary",
            "faq",
            "news"
          ]
        },
        "subCategory": {
          "type": "string"
        },
        "articleType": {
          "type": "string",
          "enum": [
            "overview",
            "history",
            "criteria",
            "accredited_list",
            "how_to_apply",
            "faq",
            "comparison",
            "case_studies",
            "insight",
            "glossary_term",
            "faq_answer"
          ]
        },
        "country": {
          "type": "string",
          "default": "global"
        },
        "publishDate": {
          "type": "string"
        },
        "lastVerified": {
          "type": "string"
        },
        "readingTime": {
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "dataSources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "fetchedDate": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "ogImage": {
          "type": "string",
          "default": "/og-images/default.svg"
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "articleType",
        "publishDate",
        "lastVerified"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}