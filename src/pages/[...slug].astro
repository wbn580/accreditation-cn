---
import { getCollection } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter(a => !a.data.draft)
    .map(a => ({
      // 2026-08-31 根因A修复：老式 type:'content' 集合在 astro 5 下 entry.id
      // 带 .md 扩展名，直接当路由参数会让全部文章落在 /xxx.md/（站内链接与
      // 干净 URL 全 404）。这里统一去掉扩展名；旧 /xxx.md/ 地址由 worker 301。
      params: { slug: a.id.replace(/\.mdx?$/, '') },
      props: { article: a, cleanSlug: a.id.replace(/\.mdx?$/, '') },
    }));
}

const { article, cleanSlug } = Astro.props;
const { Content } = await article.render();
const data = article.data;
---
<ArticleLayout
  title={data.title}
  description={data.description || ''}
  ogImage={data.ogImage}
  canonicalURL={`https://accreditation.cn/${cleanSlug}`}
  publishDate={typeof data.publishDate === 'string' ? data.publishDate : data.publishDate?.toISOString?.() || ''}
  category={data.category}
  readingTime={typeof data.readingTime === 'number' ? data.readingTime : parseInt(data.readingTime) || undefined}
  tags={Array.isArray(data.tags) ? data.tags.map(String) : []}
  dataSources={Array.isArray(data.dataSources) ? data.dataSources : []}
>
  <Content />
</ArticleLayout>
