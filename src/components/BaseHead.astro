---
// BaseHead.astro — Common <head> for all pages
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  schema?: string;
}
const {
  title,
  description,
  canonicalURL,
  ogImage = '/og-images/default.jpg',
} = Astro.props;

// 默认值必须是当前页 URL，不能是站点首页：写死首页会让每个子页都自称首页的
// 副本，GSC 报「重复，Google 选择的规范网址与用户指定的不同」并不收录
// （2026-08-17 实测 about / agent / broker 等 8 页 canonical 全指首页）。
// 本站 astro.config.mjs 没有配 `site`，所以 Astro.site 是 undefined，不能拿
// Astro.url 兜底——构建期它是 localhost，会把 canonical 写成本机地址，
// rendered_site_identity_gate 直接判串站（2026-08-17 云构建实测拦下）。
const canonicalResolved = canonicalURL || new URL(Astro.url.pathname, 'https://accreditation.cn').href;

const siteOrigin = 'https://accreditation.cn';
const siteName = '全球认证信息汇编';
// UX-FIX-WAVE1: avoid duplicating site_name when the page title already is/contains it
const fullTitle = (title && title !== siteName && !title.includes(siteName)) ? `${title} · ${siteName}` : siteName;
const requestedOg = new URL(ogImage, siteOrigin);
let resolvedOg = requestedOg.href;

// Historical content generation emitted hundreds of same-domain OG paths
// without creating the matching files. Resolve those deterministically to the
// real branded fallback at build time; external images remain untouched and
// are still checked by the shared remote-image deployment gate.
if (requestedOg.hostname.replace(/^www\./, '') === 'accreditation.cn') {
  const publicRoot = path.resolve(process.cwd(), 'public');
  const localPath = path.resolve(publicRoot, decodeURIComponent(requestedOg.pathname).replace(/^\/+/, ''));
  const safeLocalPath = localPath === publicRoot || localPath.startsWith(publicRoot + path.sep);
  if (
    !safeLocalPath
    || !fs.existsSync(localPath)
    || !fs.statSync(localPath).isFile()
    || fs.statSync(localPath).size === 0
  ) {
    resolvedOg = new URL('/og-images/default.jpg', siteOrigin).href;
  }
}
---

<!-- Primary Meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalResolved} />

<!-- Open Graph -->
<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalResolved} />
<meta property="og:image" content={resolvedOg} />
<meta property="og:site_name" content="全球认证信息汇编" />
<meta property="og:locale" content="zh_CN" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOg} />

<!-- GEO / AI -->
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
<meta name="googlebot" content="index, follow" />
<link rel="alternate" hreflang="zh-CN" href={canonicalResolved} />
<link rel="alternate" hreflang="x-default" href={canonicalResolved} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={`
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "全球认证信息汇编",
  "url": "https://accreditation.cn",
  "description": "全球认证体系中文权威信息汇编平台。独立运营，非官方机构。",
  "publisher": {
    "@type": "Organization",
    "name": "全球认证信息汇编"
  }
}
`}></script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
